# Godot 4 cache (auto-generated, not needed in source control)
.godot/

# Build output
build/

# Local MCP server config (contains machine-specific absolute paths)
.mcp.json

# 3D model assets — large binaries, not committed (see assets/models/README.md).
# The skirmish3d mode falls back to procedural figures when these are absent.
assets/models/*.glb
assets/models/*.gltf
assets/models/*.bin
assets/models/*.import
# Textures Godot extracts from the embedded .glb on import.
assets/models/*.png

# Raw downloaded asset packs — gitignored staging area, processed then deleted.
# (See tools/import_pixel_units.py and assets/models/README.md for re-download.)
assets/incoming/

